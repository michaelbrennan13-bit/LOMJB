# Clio API credentials — copy this file to `.env` and fill in.
# `.env` is gitignored and never syncs to GitHub.
#
# Create the app in the Clio Developer Portal (see tools/clio/README.md),
# set the redirect URI below on the app, then run:  python tools/clio/auth.py

CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://127.0.0.1:8321/callback

# --- Optional: only if your Clio account is NOT on the US shard (app.clio.com) ---
# CLIO_AUTHORIZE_URL=https://app.clio.com/oauth/authorize
# CLIO_TOKEN_URL=https://app.clio.com/oauth/token
